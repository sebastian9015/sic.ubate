# Puerto donde correrá el servidor backend
PORT=3000

# Clave secreta usada para firmar los tokens de sesión (JWT)
# IMPORTANTE: cámbiala por una clave larga y aleatoria antes de usar en producción
JWT_SECRET=cambia_esta_clave_secreta_antes_de_desplegar

# Tiempo de expiración del token de sesión
JWT_EXPIRES_IN=7d
